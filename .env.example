# Supabase project credentials.
# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API). Never commit the real .env.local.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public bucket used for portfolio/media assets (see supabase/schema.sql)
VITE_SUPABASE_MEDIA_BUCKET=kira-media
